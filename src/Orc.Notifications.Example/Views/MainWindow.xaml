<catel:Window x:Class="Orc.Notifications.Example.Views.MainWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:catel="http://schemas.catelproject.com"
              xmlns:orccontrols="http://schemas.wildgums.com/orc/controls" 
              xmlns:orctheming="http://schemas.wildgums.com/orc/theming"
              Height="340" Width="606">
    
    <orccontrols:StackGrid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <orctheming:ThemeSwitcherView Grid.ColumnSpan="2" />

        <Label Content="{catel:LanguageBinding Orc_Notifications_Example_TitleLabel}" />
        <TextBox Text="{Binding NotificationTitle}" />

        <Label Content="{catel:LanguageBinding Orc_Notifications_Example_MessageLabel}" />
        <TextBox Text="{Binding NotificationMessage}" AcceptsReturn="True" Height="50" />

        <Label Content="{catel:LanguageBinding Orc_Notifications_Example_PriorityLabel}" />
        <ComboBox ItemsSource="{Binding NotificationPriorities}" SelectedItem="{Binding NotificationPriority}" MaxWidth="200" HorizontalAlignment="Left"></ComboBox>
        
        <CheckBox Grid.ColumnSpan="2" Content="{catel:LanguageBinding Orc_Notifications_Example_IsClosable}" IsChecked="{Binding IsClosable}"/>
        <CheckBox Grid.ColumnSpan="2" Content="{catel:LanguageBinding Orc_Notifications_Example_MinimizeWindow}" IsChecked="{Binding MinimizeWindow}"/>

        <StackPanel Orientation="Horizontal">
            <Button Content="{catel:LanguageBinding Orc_Notifications_Example_ShowNormalNotification}" Command="{Binding ShowNotification}"  />
            <Button Content="{catel:LanguageBinding Orc_Notifications_Example_ShowWarningNotification}" Command="{Binding ShowWarningNotification}"  />
            <Button Content="{catel:LanguageBinding Orc_Notifications_Example_ShowErrorNotification}" Command="{Binding ShowErrorNotification}"  />
        </StackPanel>

    </orccontrols:StackGrid>
</catel:Window>

